# VaultGuard Secure Document Management System - Example Configuration
# Copy to .env for local development. NEVER commit real secrets to GitHub!

# 64-char hex HMAC key protecting audit log integrity chain (generate with: python -c "import secrets; print(secrets.token_hex(32))")
VAULTGUARD_AUDIT_HMAC_KEY=replace-with-64-hex-characters-generated-locally

# Optional cookie security flag (set to true behind HTTPS in production)
VAULTGUARD_COOKIE_SECURE=false

# Session lifetime and idle timeout in seconds
VAULTGUARD_SESSION_TTL_SECONDS=3600
VAULTGUARD_IDLE_TIMEOUT_SECONDS=1800

# Login brute-force protection
VAULTGUARD_MAX_FAILED_LOGINS=5
VAULTGUARD_LOCKOUT_SECONDS=300

# Maximum uploaded document size in bytes (default 10 MB)
VAULTGUARD_MAX_UPLOAD_BYTES=10485760

# Optional server host and port
VAULTGUARD_HOST=127.0.0.1
VAULTGUARD_PORT=8000
